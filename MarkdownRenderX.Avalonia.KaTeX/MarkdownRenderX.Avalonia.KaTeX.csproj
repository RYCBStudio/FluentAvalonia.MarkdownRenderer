<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!--
          版本规则（四段式）：major.minor.patch 对齐所适配的 Avalonia 版本（12.1.3），
          第四段 revision 为本组件自身的修订号。
          发布时以 git tag 为准：CI 会用 -p:Version=<tag 去掉 v 前缀> 覆盖此处默认值。
        -->
        <Version>12.1.3.4</Version>
        <AssemblyVersion>12.1.3.4</AssemblyVersion>
        <FileVersion>12.1.3.4</FileVersion>

        <PackageId>MarkdownRenderX.Avalonia.KaTeX</PackageId>
        <Authors>RYCBStudio</Authors>
        <Company>RYCBStudio</Company>
        <Product>MarkdownRenderX.Avalonia.KaTeX</Product>
        <Title>KaTeX Math for MarkdownRenderX</Title>
        <Description>KaTeX-compatible math rendering for MarkdownRenderX.Avalonia. Renders $inline$ and $$display$$ formulas natively with SkiaSharp - no WebView, no JavaScript runtime.</Description>
        <PackageProjectUrl>https://github.com/RYCBStudio/FluentAvalonia.MarkdownRenderer</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/RYCBStudio/FluentAvalonia.MarkdownRenderer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>Avalonia;Markdown;KaTeX;LaTeX;Math;Formula;MarkdownRenderX;Markdig</PackageTags>
        <PackageReleaseNotes>Math rendering extension for MarkdownRenderX.Avalonia: registers a node renderer for Markdig math nodes and lays out LaTeX with CSharpMath (SkiaSharp), shipping Latin Modern Math so no system math font is required.</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Copyright>Copyright (c) 2026 RYCBStudio</Copyright>

        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DebugType>portable</DebugType>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
        <None Include="THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- 数学字体随包分发（Latin Modern Math，GUST Font License），运行时从嵌入资源读取 -->
        <EmbeddedResource Include="Fonts/LatinModernMath.otf"
                          LogicalName="MarkdownRenderX.Avalonia.KaTeX.Fonts.LatinModernMath.otf" />
    </ItemGroup>

    <ItemGroup>
        <!-- 版本统一由仓库根目录 Directory.Packages.props 中央管理 -->
        <PackageReference Include="CSharpMath.Avalonia" />
        <PackageReference Include="Avalonia" />
        <ProjectReference Include="../MarkdownRenderX.Avalonia/MarkdownRenderX.Avalonia.csproj" />
    </ItemGroup>

</Project>
