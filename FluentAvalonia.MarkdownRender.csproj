<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!--
          版本规则（四段式）：major.minor.patch 对齐所适配的 Avalonia 版本（12.1.3），
          第四段 revision 为本组件自身的修订号。
          发布时以 git tag 为准：CI 会用 -p:Version=<tag 去掉 v 前缀> 覆盖此处默认值。
        -->
        <Version>12.1.3.1</Version>
        <AssemblyVersion>12.1.3.1</AssemblyVersion>
        <FileVersion>12.1.3.1</FileVersion>

        <PackageId>FluentAvalonia.MarkdownRender</PackageId>
        <Authors>RYCBStudio</Authors>
        <Company>RYCBStudio</Company>
        <Product>FluentAvalonia.MarkdownRender</Product>
        <Title>FluentAvalonia Markdown 渲染组件</Title>
        <Description>Avalonia / FluentAvalonia 风格的 Markdown 渲染组件，支持标题、列表、引用、代码高亮、图片、内联 HTML、GitHub 风格警告框（Alert）以及 GFM 表格。</Description>
        <PackageProjectUrl>https://github.com/RYCBStudio/FluentAvalonia.MarkdownRender</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/RYCBStudio/FluentAvalonia.MarkdownRender</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageTags>Avalonia;FluentAvalonia;Markdown;MarkdownRender;Markdig;Table;Alert;CodeHighlight</PackageTags>
        <PackageReleaseNotes>重命名自 Markdown.AIRender（https://github.com/AIDotNet/Markdown.AIRender），并新增 GFM 表格渲染支持。详见仓库 README 与 Release Notes。</PackageReleaseNotes>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Copyright>Copyright (c) 2024-2025 AIDotNet; Copyright (c) 2026 RYCBStudio</Copyright>

        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DebugType>portable</DebugType>
        <!-- 仅在 dotnet pack 时出包，日常 build 不产生 nupkg -->
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="\" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- 版本统一由仓库根目录 Directory.Packages.props 中央管理 -->
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="AvaloniaEdit.TextMate" />
        <PackageReference Include="Avalonia.Skia" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" />
        <PackageReference Include="FluentAvaloniaUI"/>
        <PackageReference Include="Markdig" />
        <PackageReference Include="SkiaSharp" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
        <PackageReference Include="TextMateSharp" />
        <PackageReference Include="TextMateSharp.Grammars" />
    </ItemGroup>

</Project>
